# Sao chép file này thành .env rồi điền giá trị thật. .env đã nằm trong .gitignore.
# Mọi biến cũng có thể truyền bằng biến môi trường (ưu tiên hơn .env), ví dụ khi deploy Cloud Run.

# ---------- MongoDB (CSDL chính) ----------
# Atlas > Connect > Drivers. Thêm tên CSDL sau dấu /, mật khẩu nên chỉ gồm chữ và số.
MONGODB_URI=mongodb+srv://user:matkhau@cum.mongodb.net/an_ninh?retryWrites=true&w=majority

# ---------- Firebase (hỗ trợ: đăng nhập và thông báo đẩy) ----------
# Project ID trong Firebase Console > Project settings.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Đường dẫn file service account (Project settings > Service accounts > Generate new private key).
# Bỏ trống khi chạy trên Google Cloud (Cloud Run) để dùng Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---------- Email OTP (bắt buộc) ----------
# Mã đăng nhập gửi qua email. Mặc định dùng Gmail (miễn phí, khoảng 500 email/ngày):
#   1. Bật Xác minh 2 bước cho tài khoản Google: https://myaccount.google.com/security
#   2. Tạo Mật khẩu ứng dụng: https://myaccount.google.com/apppasswords (đặt tên "campus safety")
#   3. Dán địa chỉ Gmail vào SMTP_USERNAME và mật khẩu 16 ký tự vào SMTP_PASSWORD
#      (KHÔNG dùng mật khẩu đăng nhập Gmail; dấu cách trong mật khẩu ứng dụng có hay không đều được).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Tên người gửi hiển thị trong hộp thư.
MAIL_FROM_NAME=An ninh trường học

# Khi deploy ở nơi chặn cổng SMTP (Render miễn phí): gửi qua Google Apps Script thay cho SMTP.
# Dán backend/tool/apps_script/Code.gs vào script.google.com, triển khai dạng Web app.
# Có MAIL_SCRIPT_URL thì không cần SMTP_USERNAME, SMTP_PASSWORD.
# MAIL_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# MAIL_SCRIPT_SECRET=chuoi-ngau-nhien-it-nhat-32-ky-tu

# ---------- Bảo mật OTP ----------
# Chuỗi bí mật ngẫu nhiên >= 32 ký tự để băm OTP (HMAC-SHA256). Tạo bằng:
#   dart run tool/generate_secret.dart
OTP_PEPPER=

# ---------- Tài khoản ----------
# true: ai có email hợp lệ đều đăng nhập được (vai trò người báo).
# false: chỉ email đã được quản trị tạo trước mới đăng nhập được.
ALLOW_SELF_REGISTRATION=true
# Email luôn có quyền quản trị (cách nhau bằng dấu phẩy). Dùng để tạo quản trị đầu tiên.
BOOTSTRAP_ADMIN_EMAILS=

# ---------- Trực an ninh ----------
# Số trực an ninh hiển thị cho nút "Gọi trực" (quản trị có thể đổi trong app).
DUTY_HOTLINE=
CAMPUS_NAME=Trường Đại học

# ---------- Máy chủ ----------
# true khi chạy sau proxy/load balancer (Cloud Run, Nginx) để lấy IP thật từ X-Forwarded-For.
TRUST_PROXY=false
